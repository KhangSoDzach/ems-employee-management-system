# Environment Variables for Employee Management System Backend

# Database Configuration
DB_PASSWORD=your_mysql_password_here

# JWT Configuration (REQUIRED FOR PRODUCTION)
# Generate secure keys using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Or use: openssl rand -hex 64

JWT_SECRET=your_jwt_secret_key_minimum_256_bits_64_characters
JWT_REFRESH_SECRET=your_refresh_token_secret_key_minimum_256_bits_64_characters

# Example (DO NOT USE IN PRODUCTION):
# JWT_SECRET=4f8b5c3a9e7d2b1f6a4c8e3d9b7a5f2c8e6b4d1a7f3c9e5b2d8a6f4c1e7b9a3d5e2f8b1c4a7d
# JWT_REFRESH_SECRET=9a3d5e2f8b1c4a7d6f3b9e5c1a8d4b7f2e9c6a3d8f5b2e7c1a4d9b6e3f8c5a2d7b4e1f9c6b3a8d

# Optional: Server Port (default: 8080)
# SERVER_PORT=8080

# Note: application.yaml dùng ${ENV_VAR:default} nên không cần Spring profile riêng.
# SPRING_PROFILES_ACTIVE không có effect trừ khi bạn tạo application-docker.yaml.
# For production, ALWAYS set JWT_SECRET and JWT_REFRESH_SECRET via environment variables.

# ─────────────────────────────────────────────────────────────────────────────
# Email / SMTP Configuration (for Forgot Password OTP)
# ─────────────────────────────────────────────────────────────────────────────
# For local dev use Mailtrap (https://mailtrap.io) – free SMTP sandbox.
# For production use Gmail App Password or a real SMTP relay.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=no-reply@ems.company.com
