# Environment variables for Docker Compose
# Copy this file to .env and update values for your environment

# MySQL Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_USER=emsuser
MYSQL_PASSWORD=emspass123

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-required-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Application Configuration
SPRING_PROFILES_ACTIVE=dev

# Mail Configuration (for employee credentials & password reset OTP)
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=no-reply@ems.company.com
