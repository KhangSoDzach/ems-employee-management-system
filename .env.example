# Environment variables for Docker Compose
# Copy this file to .env and update values for your environment
# This file is used ONLY for Docker-based environments (integration, testing, prod review)

# MySQL Configuration (Docker service)
MYSQL_ROOT_PASSWORD=
MYSQL_USER=emsuser
MYSQL_PASSWORD=emspass123

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-required-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Application Configuration
# "docker" → Docker Compose (mysql service as DB host)
# "dev"    → Local development with XAMPP MySQL (set in IDE/Maven run config, NOT here)
SPRING_PROFILES_ACTIVE=docker
