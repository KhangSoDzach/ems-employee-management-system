{
  "dependencies": {
    "data-fns": "^1.1.0",
    "framer-motion": "^12.34.5",
    "i": "^0.3.7",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "shx": "^0.4.0",
    "stylelint": "^17.4.0"
  },
  "scripts": {
    "prepare": "husky",
    "check:conflicts": "git diff --cached --check"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --config frontend/eslint.config.js --fix --max-warnings=0",
      "prettier --write"
    ],
    "frontend/**/*.{css,scss,html}": [
      "prettier --write"
    ],
    "**/*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
